@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.FormTagHelper", "Microsoft.AspNetCore.Mvc.TagHelpers"
@using SmartFoundation.UI.ViewModels.SmartTable
@using SmartFoundation.UI.ViewModels.SmartForm
@using SmartFoundation.UI.ViewModels.SmartPage
@using SmartFoundation.UI.ViewModels.SmartPage
@model SmartFoundation.UI.ViewModels.SmartPage.SmartPageViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var header = ViewBag.TicketHeader as Dictionary<string, string?>;
    var auditTrail = ViewBag.TicketAuditTrail as List<Dictionary<string, object>>;
    var childTickets = ViewBag.ChildTickets as List<Dictionary<string, object>>;
    var pauseSessions = ViewBag.PauseSessions as List<Dictionary<string, object>>;
    var qualityReviews = ViewBag.QualityReviews as List<Dictionary<string, object>>;
    var clarificationRequests = ViewBag.ClarificationRequests as List<Dictionary<string, object>>;
    var statusCode = header["statusCode"] ?? "";
    var priorityCode = header["priorityCode"] ?? "";
    var priorityName = header["priorityName"] ?? "";
    var isBlocked = string.Equals(header["isBlocked"], "True", StringComparison.OrdinalIgnoreCase)
                 || string.Equals(header["isBlocked"], "1", StringComparison.Ordinal);
    var hasSla = !string.IsNullOrWhiteSpace(header["slaElapsedMinutes"]);
    var slaBreached = string.Equals(header["slaIsBreached"], "True", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(header["slaIsBreached"], "1", StringComparison.Ordinal);
    var parsedHeaderSlaElapsedMinutes = 0;
    var parsedHeaderSlaTargetMinutes = 0;
    if (int.TryParse(header["slaElapsedMinutes"], out parsedHeaderSlaElapsedMinutes)
        && int.TryParse(header["slaTargetMinutes"], out parsedHeaderSlaTargetMinutes)
        && parsedHeaderSlaTargetMinutes > 0)
    {
        slaBreached = parsedHeaderSlaElapsedMinutes > parsedHeaderSlaTargetMinutes;
    }
    var requiresQualityReview = string.Equals(header["requiresQualityReview"], "True", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(header["requiresQualityReview"], "1", StringComparison.Ordinal);
    var assigneeName = string.IsNullOrWhiteSpace(header["assignedUserName"]) || header["assignedUserName"] == "--"
        ? "غير معين"
        : header["assignedUserName"];
    var locationParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(header["locationBuildingNo"])) locationParts.Add($"مبنى {header["locationBuildingNo"]}");
    if (!string.IsNullOrWhiteSpace(header["locationUnitNo"])) locationParts.Add($"وحدة {header["locationUnitNo"]}");
    if (!string.IsNullOrWhiteSpace(header["locationArea"])) locationParts.Add(header["locationArea"]!);
    var locationText = locationParts.Count > 0 ? string.Join("، ", locationParts) : "غير محدد";

    var showPause = statusCode is "IN_PROGRESS" or "ASSIGNED";
    var showResume = statusCode == "PAUSED";
    var showAssign = statusCode == "NEW";
    var showStartWork = statusCode == "ASSIGNED";
    var showResolve = statusCode is "IN_PROGRESS" or "ASSIGNED";
}

<link rel="stylesheet" href="~/css/ticket-details.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/SlaPanel.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/ticket-timeline.css" asp-append-version="true" />
<script src="~/js/SlaPanel.js" asp-append-version="true"></script>
<script src="~/js/ticket-timeline.js" asp-append-version="true"></script>

@functions {
    static string StatusBadgeClass(string code) => code switch
    {
        "NEW" => "status-badge-gray",
        "ROUTED" => "status-badge-blue",
        "ASSIGNED" => "status-badge-blue",
        "IN_PROGRESS" => "status-badge-yellow",
        "RESOLVED" => "status-badge-green",
        "PAUSED" => "status-badge-blue",
        "CLOSED" => "status-badge-gray",
        "REOPENED" => "status-badge-yellow",
        "REJECTED" => "status-badge-red",
        "CLARIFICATION" => "status-badge-purple",
        "ARBITRATION" => "status-badge-purple",
        _ => "status-badge-gray"
    };

    static string PriorityBadgeClass(string code)
    {
        var u = (code ?? "").ToUpper();
        if (u == "CRITICAL") return "status-badge-red";
        if (u == "HIGH") return "status-badge-orange";
        if (u == "MEDIUM") return "status-badge-yellow";
        if (u == "LOW") return "status-badge-green";
        return "status-badge-yellow";
    }

    static string FormatValue(string? value, string fallback = "غير متوفر")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }

    static string FormatDate(object? val)
    {
        if (val == null) return "غير متوفر";
        if (DateTime.TryParse(val.ToString(), out var dt))
            return dt.ToString("dd MMM yyyy، hh:mm tt", new System.Globalization.CultureInfo("ar-SA"));
        return val.ToString() ?? "غير متوفر";
    }

    static string FormatElapsed(string? minutes)
    {
        if (string.IsNullOrWhiteSpace(minutes) || !int.TryParse(minutes, out var m)) return "غير متوفر";
        var hours = m / 60;
        var mins = m % 60;
        if (hours == 0) return $"{mins} د";
        if (mins == 0) return $"{hours} س";
        return $"{hours} س {mins} د";
    }
}

@await Component.InvokeAsync("SmartRenderer", new { model = Model })
return;

@{
    var header = ViewBag.TicketHeader as Dictionary<string, string?>;
    var auditTrail = ViewBag.TicketAuditTrail as List<Dictionary<string, object>>;
    var childTickets = ViewBag.ChildTickets as List<Dictionary<string, object>>;
    var pauseSessions = ViewBag.PauseSessions as List<Dictionary<string, object>>;
    var qualityReviews = ViewBag.QualityReviews as List<Dictionary<string, object>>;
    var clarificationRequests = ViewBag.ClarificationRequests as List<Dictionary<string, object>>;
    var statusCode = header["statusCode"] ?? "";
    var priorityCode = header["priorityCode"] ?? "";
    var priorityName = header["priorityName"] ?? "";
    var isBlocked = string.Equals(header["isBlocked"], "True", StringComparison.OrdinalIgnoreCase)
                 || string.Equals(header["isBlocked"], "1", StringComparison.Ordinal);
    var hasSla = !string.IsNullOrWhiteSpace(header["slaElapsedMinutes"]);
    var slaBreached = string.Equals(header["slaIsBreached"], "True", StringComparison.OrdinalIgnoreCase)
                   || string.Equals(header["slaIsBreached"], "1", StringComparison.Ordinal);
    var parsedHeaderSlaElapsedMinutes = 0;
    var parsedHeaderSlaTargetMinutes = 0;
    if (int.TryParse(header["slaElapsedMinutes"], out parsedHeaderSlaElapsedMinutes)
        && int.TryParse(header["slaTargetMinutes"], out parsedHeaderSlaTargetMinutes)
        && parsedHeaderSlaTargetMinutes > 0)
    {
        slaBreached = parsedHeaderSlaElapsedMinutes > parsedHeaderSlaTargetMinutes;
    }
    var requiresQualityReview = string.Equals(header["requiresQualityReview"], "True", StringComparison.OrdinalIgnoreCase)
                             || string.Equals(header["requiresQualityReview"], "1", StringComparison.Ordinal);
    var assigneeName = string.IsNullOrWhiteSpace(header["assignedUserName"]) || header["assignedUserName"] == "--"
        ? "غير معين"
        : header["assignedUserName"];
    var locationParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(header["locationBuildingNo"])) locationParts.Add($"مبنى {header["locationBuildingNo"]}");
    if (!string.IsNullOrWhiteSpace(header["locationUnitNo"])) locationParts.Add($"وحدة {header["locationUnitNo"]}");
    if (!string.IsNullOrWhiteSpace(header["locationArea"])) locationParts.Add(header["locationArea"]!);
    var locationText = locationParts.Count > 0 ? string.Join("، ", locationParts) : "غير محدد";

    // Determine which action buttons to show based on status
    var showPause = statusCode is "IN_PROGRESS" or "ASSIGNED";
    var showResume = statusCode == "PAUSED";
    var showAssign = statusCode == "NEW";
    var showStartWork = statusCode == "ASSIGNED";
    var showResolve = statusCode is "IN_PROGRESS" or "ASSIGNED";
}

<div class="ticket-details-page" dir="rtl">
    <div class="ticket-details-container">
        <a href="@Url.Action("TicketList", "Ticket")" class="ticket-back-link">
            <i class="fa-solid fa-arrow-right"></i>
            رجوع إلى قائمة التذاكر
        </a>

        <!-- Header Section -->
        <header class="ticket-header-section">
            <div class="ticket-header-top">
                <div class="ticket-id-title">
                    <h1 class="ticket-id">@FormatValue(header["ticketNo"], "--")</h1>
                    <p class="ticket-subtitle">@FormatValue(header["title"], "بدون عنوان")</p>
                </div>
                <div class="ticket-status-badges">
                    <span class="status-badge @StatusBadgeClass(statusCode)">@FormatValue(header["statusName"], statusCode)</span>
                    @if (!string.IsNullOrWhiteSpace(priorityName))
                    {
                        <span class="status-badge @PriorityBadgeClass(priorityCode)">@priorityName</span>
                    }
                    @if (isBlocked)
                    {
                        <span class="status-badge status-badge-red">محظور</span>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="ticket-action-buttons">
                @if (showPause)
                {
                    <button class="ticket-btn ticket-btn-gray" title="إيقاف مؤقت">
                        <i class="fa-solid fa-pause"></i>
                        إيقاف
                    </button>
                }
                @if (showResume)
                {
                    <button class="ticket-btn ticket-btn-blue" title="استئناف العمل">
                        <i class="fa-solid fa-play"></i>
                        استئناف
                    </button>
                }
                @if (showAssign)
                {
                    <button class="ticket-btn ticket-btn-blue" title="تعيين التذكرة">
                        <i class="fa-solid fa-user-plus"></i>
                        تعيين
                    </button>
                }
                @if (showStartWork)
                {
                    <button class="ticket-btn ticket-btn-green" title="بدء العمل">
                        <i class="fa-solid fa-play"></i>
                        بدء العمل
                    </button>
                }
                @if (showResolve)
                {
                    <button class="ticket-btn ticket-btn-green" title="حل التذكرة">
                        <i class="fa-solid fa-check"></i>
                        حل
                    </button>
                }
                <button class="ticket-btn ticket-btn-purple" title="إنشاء تذكرة فرعية">
                    <i class="fa-solid fa-plus"></i>
                    إنشاء تذكرة فرعية
                </button>
                <button class="ticket-btn ticket-btn-orange" title="طلب توضيح">
                    <i class="fa-solid fa-question"></i>
                    طلب توضيح
                </button>
                <button class="ticket-btn ticket-btn-red" title="رفع تحكيم">
                    <i class="fa-solid fa-gavel"></i>
                    رفع تحكيم
                </button>
            </div>
        </header>

        <!-- Main Content Layout -->
        <div class="ticket-main-layout">
            <!-- Left Column -->
            <div class="ticket-content-left">
                <!-- Description Section -->
                <section class="ticket-card">
                    <div class="ticket-card-header">
                        <h2 class="ticket-card-title">الوصف</h2>
                    </div>
                    <div class="ticket-card-body">
                        <p class="ticket-description">@FormatValue(header["description"], "لا يوجد وصف مسجل لهذه التذكرة.")</p>
                    </div>
                </section>

                <!-- Related Tickets Section -->
                @if (childTickets != null && childTickets.Count > 0)
                {
                    <section class="ticket-card">
                        <div class="ticket-card-header">
                            <h2 class="ticket-card-title">
                                <i class="fa-solid fa-link"></i>
                                التذاكر المرتبطة
                            </h2>
                        </div>
                        <div class="ticket-card-body">
                            @foreach (var child in childTickets)
                            {
                                var cNo = child["ticketNo"]?.ToString();
                                var cTitle = child["title"]?.ToString();
                                var cStatusCode = child["statusCode"]?.ToString() ?? string.Empty;
                                var cStatusName = child["statusName"]?.ToString() ?? cStatusCode;
                                var cId = child["ticketID"]?.ToString();

                                <div class="ticket-related-item">
                                    <div class="ticket-related-header">
                                        <span class="ticket-relation-tag">فرعية</span>
                                        <a href="@Url.Action("TicketDetails", "Ticket", new { id = cId })"
                                           class="ticket-related-link">@FormatValue(cNo, "تذكرة مرتبطة")</a>
                                        </div>
                                        <span class="status-badge @StatusBadgeClass(cStatusCode)">@FormatValue(cStatusName, cStatusCode)</span>
                                    </div>
                                    <p class="ticket-related-desc">@FormatValue(cTitle, "بدون عنوان")</p>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Clarification Requests Section (conditional based on status) -->
                @if (statusCode == "CLARIFICATION")
                {
                    <section class="ticket-card">
                        <div class="ticket-card-header">
                            <h2 class="ticket-card-title">
                                <i class="fa-solid fa-question-circle"></i>
                                طلبات التوضيح
                            </h2>
                        </div>
                        <div class="ticket-card-body">
                            <div class="ticket-clarification-item">
                                <div class="ticket-clarification-header">
                                    <span class="ticket-clarification-reason">معلومات ناقصة</span>
                                    <span class="status-badge status-badge-purple">مفتوح</span>
                                </div>
                                <p class="ticket-clarification-question">
                                    يرجى تزويدنا بمزيد من التفاصيل حول هذه التذكرة لإكمال المعالجة.
                                </p>
                                <p class="ticket-clarification-meta">من: النظام • إلى: @FormatValue(assigneeName) • @FormatDate(header["entryDate"])</p>
                            </div>
                        </div>
                    </section>
                }

                <!-- Arbitration Cases Section (conditional based on status) -->
                @if (statusCode == "ARBITRATION")
                {
                    <section class="ticket-card">
                        <div class="ticket-card-header">
                            <h2 class="ticket-card-title">
                                <i class="fa-solid fa-gavel"></i>
                                قضايا التحكيم
                            </h2>
                        </div>
                        <div class="ticket-card-body">
                            <div class="ticket-arbitration-item">
                                <div class="ticket-arbitration-header">
                                    <span class="ticket-arbitration-title">تحديد الجهة المسؤولة</span>
                                    <span class="status-badge status-badge-yellow">مفتوح</span>
                                </div>
                                <p class="ticket-arbitration-desc">
                                    يتطلب تحديد القسم أو الجهة المسؤولة عن معالجة هذه التذكرة.
                                </p>
                                <p class="ticket-arbitration-meta">رفعها: النظام • المحكم: مدير العمليات المركزية • @FormatDate(header["entryDate"])</p>
                            </div>
                        </div>
                    </section>
                }

                <!-- Quality Reviews Section -->
                @if ((qualityReviews != null && qualityReviews.Count > 0) || requiresQualityReview)
                {
                    <section class="ticket-card">
                        <div class="ticket-card-header">
                            <h2 class="ticket-card-title">
                                <i class="fa-solid fa-clipboard-check"></i>
                                مراجعات الجودة
                            </h2>
                        </div>
                        <div class="ticket-card-body">
                            @if (qualityReviews != null && qualityReviews.Count > 0)
                            {
                                @foreach (var review in qualityReviews)
                                {
                                    var resultCode = review["qualityReviewResultCode"]?.ToString();
                                    var resultName = review["qualityReviewResultName"]?.ToString();
                                    var reviewNotes = review["reviewNotes"]?.ToString();
                                    var reviewerName = review["reviewerName"]?.ToString();
                                    var finalized = string.Equals(review["finalized"]?.ToString(), "True", StringComparison.OrdinalIgnoreCase)
                                                 || string.Equals(review["finalized"]?.ToString(), "1", StringComparison.Ordinal);

                                    <div class="ticket-review-item">
                                        <div class="ticket-review-header">
                                            <span class="ticket-review-title">@FormatValue(resultName, "مراجعة جودة")</span>
                                            <span class="status-badge @(finalized ? "status-badge-green" : "status-badge-blue")">
                                                @(finalized ? "مكتملة" : "قيد المراجعة")
                                            </span>
                                        </div>
                                        <p class="ticket-review-desc">@FormatValue(reviewNotes, "تم تسجيل مراجعة جودة بدون ملاحظات إضافية.")</p>
                                        <p class="ticket-review-meta">المراجع: @FormatValue(reviewerName, "مراجع الجودة") • @FormatDate(review["entryDate"])</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="ticket-empty-state">هذه التذكرة تتطلب مراجعة جودة، لكن لا توجد مراجعات مسجلة حتى الآن.</p>
                            }
                        </div>
                    </section>
                }

                <!-- Audit Trail Section - Using TicketTimeline Component -->
                @if (auditTrail != null && auditTrail.Count > 0)
                {
                    @await Component.InvokeAsync("TicketTimeline", new TicketTimelineConfig {
                        Title = "سجل المتابعة",
                        Events = auditTrail.Select(evt => new TimelineEvent {
                            ActionCode = evt["actionTypeCode"]?.ToString(),
                            ActionNameArabic = evt["actionNameAr"]?.ToString(),
                            NewStatusCode = evt["newStatusCode"]?.ToString(),
                            NewStatusName_A = evt["newStatusName_A"]?.ToString() ?? evt["newStatusName_E"]?.ToString(),
                            Notes = evt["notes"]?.ToString(),
                            PerformerName = evt["performerName"]?.ToString(),
                            ActionDate = evt["actionDate"]?.ToString() != "" ? DateTime.Parse(evt["actionDate"]) : (DateTime?)null
                        }).ToList()
                    })
                }
            </div>

            <!-- Right Sidebar -->
            <aside class="ticket-content-right">
                <!-- Ticket Information -->
                <section class="ticket-sidebar-card">
                    <div class="ticket-sidebar-header">
                        <h2 class="ticket-sidebar-title">معلومات التذكرة</h2>
                    </div>
                    <div class="ticket-sidebar-body">
                        <ul class="ticket-info-list">
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">الخدمة</span>
                                <span class="ticket-info-value">@FormatValue(header["serviceName"])</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">مقدم الطلب</span>
                                <span class="ticket-info-value">@FormatValue(header["requesterName"])</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">نوع مقدم الطلب</span>
                                <span class="ticket-info-value">@FormatValue(header["requesterTypeName"])</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">التصنيف</span>
                                <span class="ticket-info-value">الصيانة</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">القسم</span>
                                <span class="ticket-info-value">الصيانة</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">الفرع</span>
                                <span class="ticket-info-value">-</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">الوحدة</span>
                                <span class="ticket-info-value">-</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">الطابور الحالي</span>
                                <span class="ticket-info-value">@FormatValue(header["serviceName"])</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">المكلف بالعمل</span>
                                <span class="ticket-info-value @(string.IsNullOrWhiteSpace(header["assignedUserName"]) || header["assignedUserName"] == "--" ? "empty" : "")">
                                    @FormatValue(assigneeName)
                                </span>
                            </li>
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(locationText) && locationText != "غير محدد")
                        {
                            <div class="ticket-location-info">
                                <i class="fa-solid fa-location-dot"></i>
                                <span>@locationText</span>
                            </div>
                        }
                    </div>
                </section>

                <!-- SLA Status - Using SlaPanel Component -->
                @if (hasSla)
                {
                    @if (int.TryParse(header["slaElapsedMinutes"], out var slaElapsedMinutes)
                        && int.TryParse(header["slaTargetMinutes"], out var slaTargetMinutes)
                        && slaTargetMinutes > 0)
                    {
                        var achievedPercentage = slaElapsedMinutes > 0
                            ? Math.Min(100, Math.Round((decimal)slaTargetMinutes / slaElapsedMinutes * 100, 1))
                            : 0m;

                        var slaColor = slaBreached ? "red" : "green";

                        @await Component.InvokeAsync("SlaPanel", new SlaPanelConfig {
                            Title = "حالة مستوى الخدمة",
                            ResponseTimeMinutes = slaTargetMinutes / 60,
                            ResolutionTimeMinutes = slaTargetMinutes / 60,
                            AchievedPercentage = achievedPercentage,
                            ShowDetails = true,
                            ColorScheme = slaColor
                        })
                    }
                }

                <!-- Pause Sessions -->
                @if (pauseSessions != null && pauseSessions.Count > 0)
                {
                    <section class="ticket-sidebar-card">
                        <div class="ticket-sidebar-header">
                            <h2 class="ticket-sidebar-title">جلسات الإيقاف</h2>
                        </div>
                        <div class="ticket-sidebar-body">
                            @foreach (var ps in pauseSessions)
                            {
                                var psReason = ps["pauseReasonName"]?.ToString();
                                var psNotes = ps["pauseNotes"]?.ToString();
                                var psEnd = ps["pauseEnd"]?.ToString();
                                var isActivePause = psEnd == null && (ps["ticketPauseSessionActive"]?.ToString() != "0");

                                <div class="ticket-pause-item @(isActivePause ? "active" : "")">
                                    <div class="ticket-pause-header">
                                        <span class="ticket-pause-reason">@FormatValue(psReason)</span>
                                        @if (isActivePause)
                                        {
                                            <span class="status-badge status-badge-yellow">نشط</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(psNotes))
                                    {
                                        <p class="ticket-pause-desc">@psNotes</p>
                                    }
                                    <p class="ticket-pause-meta">بدأت: @FormatDate(ps["pauseStart"])</p>
                                </div>
                            }
                        </div>
                    </section>
                }

                <!-- Dates -->
                <section class="ticket-sidebar-card">
                    <div class="ticket-sidebar-header">
                        <h2 class="ticket-sidebar-title">التواريخ</h2>
                    </div>
                    <div class="ticket-sidebar-body">
                        <ul class="ticket-info-list">
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">تاريخ الإنشاء</span>
                                <span class="ticket-info-value">@FormatDate(header["entryDate"])</span>
                            </li>
                            <li class="ticket-info-item">
                                <span class="ticket-info-label">آخر تحديث</span>
                                <span class="ticket-info-value">@FormatValue(header["lastUpdated"] ?? header["entryDate"])</span>
                            </li>
                            @if (!string.IsNullOrWhiteSpace(header["operationalResolutionDate"]))
                            {
                                <li class="ticket-info-item">
                                    <span class="ticket-info-label">تاريخ الحل</span>
                                    <span class="ticket-info-value">@FormatDate(header["operationalResolutionDate"])</span>
                                </li>
                            }
                            @if (!string.IsNullOrWhiteSpace(header["finalClosureDate"]))
                            {
                                <li class="ticket-info-item">
                                    <span class="ticket-info-label">تاريخ الإغلاق</span>
                                    <span class="ticket-info-value">@FormatDate(header["finalClosureDate"])</span>
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</div>
